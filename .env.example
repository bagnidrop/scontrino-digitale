# Copia questo file in ".env" sul server e compila i valori.
# Dominio che punta all'IP del server (record DNS di tipo A), senza https://
DOMAIN=scontrini.tuodominio.it

# Stringa lunga e casuale:  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=cambiami

# 1 = chiunque può registrarsi; metti 0 dopo aver creato il tuo account
ALLOW_REGISTRATION=1

# Invio messaggi: "console" = prova (non spedisce), "twilio" = reale
MESSAGING_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_CONTENT_SID=
